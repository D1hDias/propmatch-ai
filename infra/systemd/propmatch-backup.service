[Unit]
Description=PropMatch AI — pgBackRest backup
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=postgres
EnvironmentFile=/etc/propmatch/backup.env
ExecStart=/opt/propmatch/infra/backup/backup.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pgbackrest-backup

# Alert on failure via systemd-email or BetterStack heartbeat
OnFailure=status-email@%n.service
