// PropMatch AI — Prisma Schema
// Tables are added per sprint. See docs/data-model.md for the full spec.
//
// Sprint 1 (INFRA-1): empty schema — connection config only
// Sprint 1 (AUTH-1):  users, agencies, lgpd_jobs, audit_log
// Sprint 2 (DATA-1):  briefings, hitl_metrics  ← current
// Sprint 3 (DATA-2):  properties, property_sources
// Sprint 4 (DATA-3):  briefing_results
// Sprint 5 (DATA-4):  clients + briefings.client_id constraint
// Sprint 6 (DATA-6):  messages

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  broker
  owner
  admin
}

enum UserPlan {
  free
  starter
  pro
}

enum LgpdJobType {
  export
  delete
}

enum LgpdJobStatus {
  requested
  cancellable
  in_progress
  completed
  failed
}

// DATA-4 enum
enum ClientArchiveStatus {
  active
  soft_archived
  pending_delete
}

// DATA-1 enums
enum BriefingReviewStatus {
  not_required
  pending
  approved
  corrected
  overflow_broker_edit
}

enum BriefingReviewMode {
  hitl
  broker_direct_edit
  auto_approved
}

enum BriefingStatus {
  extracting
  searching
  ready
  failed
}

enum HitlOutcome {
  approved
  corrected
  overflow_redirect
}

// ---------------------------------------------------------------------------
// Sprint 1 tables — AUTH-1
// ---------------------------------------------------------------------------

// AUTH-1: Multi-broker offices (optional grouping)
model Agency {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  seatCount   Int      @map("seat_count")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  ownerUser   User     @relation("AgencyOwner", fields: [ownerUserId], references: [id])
  ownerUserId String   @unique @map("owner_user_id") @db.Uuid

  members     User[]   @relation("AgencyMembers")

  @@map("agencies")
}

// AUTH-1: Authenticated users (brokers, owners, admins)
model User {
  id             String    @id @default(uuid()) @db.Uuid
  email          String    @unique
  name           String
  phone          String?
  passwordHash   String    @map("password_hash")
  role           UserRole  @default(broker)
  plan           UserPlan  @default(free)
  lgpdConsentAt  DateTime  @map("lgpd_consent_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  agency         Agency?   @relation("AgencyMembers", fields: [agencyId], references: [id])
  agencyId       String?   @map("agency_id") @db.Uuid

  ownedAgency    Agency?   @relation("AgencyOwner")

  lgpdJobs       LgpdJob[]
  auditEvents    AuditLog[]
  refreshTokens  RefreshToken[]
  briefings      Briefing[]
  clients        Client[]

  @@index([agencyId])
  @@map("users")
}

// AUTH-1 + AUTH-4: DSAR audit trail (export and deletion requests)
model LgpdJob {
  id                 String        @id @default(uuid()) @db.Uuid
  jobType            LgpdJobType   @map("job_type")
  status             LgpdJobStatus @default(requested)
  requestedAt        DateTime      @default(now()) @map("requested_at") @db.Timestamptz
  completedAt        DateTime?     @map("completed_at") @db.Timestamptz
  cancellationToken  String?       @map("cancellation_token") @db.VarChar(64)

  user               User          @relation(fields: [userId], references: [id])
  userId             String        @map("user_id") @db.Uuid

  @@index([userId, status])
  @@map("lgpd_jobs")
}

// AUTH-2: Active refresh token sessions (one row per active session per user)
model RefreshToken {
  id          String    @id @default(uuid()) @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.VarChar(64)
  userId      String    @map("user_id") @db.Uuid
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user        User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Sprint 5 tables — DATA-4
// ---------------------------------------------------------------------------

// DATA-4: Broker clients — real contacts or auto-created guests.
// State machine: active → soft_archived → pending_delete (OPS-3/4/5 drive transitions).
enum ClientUrgency {
  ativo       // buscando ativamente — re-scan diário
  prazo       // tem data limite — re-scan diário
  explorando  // sem pressa — re-scan semanal

  @@map("client_urgency")
}

enum ClientCrmStatus {
  ativo        // perfil ativo, em busca
  negociacao   // proposta em andamento
  fechado      // negócio fechado
  pausado      // cliente pausou a busca

  @@map("client_crm_status")
}

model Client {
  id              String              @id @default(uuid()) @db.Uuid
  userId          String              @map("user_id") @db.Uuid
  name            String
  phone           String?
  email           String?
  isGuest         Boolean             @default(false) @map("is_guest")
  archiveStatus   ClientArchiveStatus @default(active) @map("archive_status")
  // S12: CRM pipeline status
  crmStatus       ClientCrmStatus     @default(ativo) @map("crm_status")
  // S12: urgency drives re-scan frequency
  urgency         ClientUrgency       @default(explorando)
  // S12: match threshold for notifications (0-100)
  matchThreshold  Int                 @default(70) @map("match_threshold")
  // S12: rich search profile stored as JSONB
  profile         Json?               @db.JsonB
  reminderSentAt  DateTime?           @map("reminder_sent_at") @db.Timestamptz
  softArchivedAt  DateTime?           @map("soft_archived_at") @db.Timestamptz
  autoPurgeAt     DateTime?           @map("auto_purge_at") @db.Timestamptz
  notes           String?
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz

  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  briefings       Briefing[]
  messages        Message[]

  @@index([userId, archiveStatus])
  @@index([userId, crmStatus])
  @@index([userId, urgency])
  @@index([autoPurgeAt])
  @@index([userId, createdAt(sort: Desc)])
  @@map("clients")
}

// ---------------------------------------------------------------------------
// Sprint 2 tables — DATA-1
// ---------------------------------------------------------------------------

// DATA-1: Core briefing entity. client_id is NOT NULL after DATA-5 backfill migration.
model Briefing {
  id                    String               @id @default(uuid()) @db.Uuid
  userId                String               @map("user_id") @db.Uuid
  clientId              String               @map("client_id") @db.Uuid
  rawText               String               @map("raw_text")
  rawTextPurgeAt        DateTime             @map("raw_text_purge_at") @db.Timestamptz
  extractedCriteria     Json?                @map("extracted_criteria") @db.JsonB
  extractionConfidence  Decimal?             @map("extraction_confidence") @db.Decimal(4, 3)
  // S11: sources selected by the broker for this search
  selectedPortals       String[]             @default([]) @map("selected_portals")
  customUrls            String[]             @default([]) @map("custom_urls")
  reviewStatus          BriefingReviewStatus @default(pending) @map("review_status")
  reviewMode            BriefingReviewMode?  @map("review_mode")
  reviewedBy            String?              @map("reviewed_by") @db.Uuid
  autoWidenUsed         Boolean              @default(false) @map("auto_widen_used")
  status                BriefingStatus       @default(extracting)
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz

  user                  User                 @relation(fields: [userId], references: [id])
  client                Client               @relation(fields: [clientId], references: [id])
  hitlMetrics           HitlMetric[]
  results               BriefingResult[]
  messages              Message[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([clientId])
  @@index([rawTextPurgeAt])
  @@map("briefings")
}

// DATA-1: HITL review SLA tracking. One row per HITL-routed briefing.
model HitlMetric {
  id                 String      @id @default(uuid()) @db.Uuid
  briefingId         String      @map("briefing_id") @db.Uuid
  queuedAt           DateTime    @default(now()) @map("queued_at") @db.Timestamptz
  reviewedAt         DateTime?   @map("reviewed_at") @db.Timestamptz
  reviewDurationMs   Int?        @map("review_duration_ms")
  reviewerId         String?     @map("reviewer_id") @db.Uuid
  outcome            HitlOutcome?

  briefing           Briefing    @relation(fields: [briefingId], references: [id])

  @@index([briefingId])
  @@map("hitl_metrics")
}

// ---------------------------------------------------------------------------
// Sprint 3 tables — DATA-2
// ---------------------------------------------------------------------------

// DATA-2: Source identifiers for property adapters.
enum PropertySource {
  zap
  vivareal
  mock
  portal_x
  partner_b
}

// DATA-2: Property type classification
enum PropertyType {
  apartment
  house
  studio
  penthouse
  commercial
  warehouse
  land
  other
}

// DATA-2: Canonical deduplicated property record.
// One row per real-world property regardless of how many sources list it.
// Deduplication key: address_normalized + geohash7 + bedrooms.
model Property {
  id                 String         @id @default(uuid()) @db.Uuid
  addressNormalized  String         @map("address_normalized")
  geohash7           String?        @map("geohash7") @db.VarChar(7)
  neighborhood       String?
  city               String
  state              String         @db.VarChar(2)
  propertyType       PropertyType   @map("property_type")
  bedrooms           Int?
  bathrooms          Int?
  areaSqm            Decimal?       @map("area_sqm") @db.Decimal(8, 2)
  parkingSpots       Int?           @map("parking_spots")
  // Primary price and sale type come from the most recent authoritative source
  price              Decimal        @db.Decimal(14, 2)
  priceType          String         @map("price_type") @db.VarChar(4) // 'sale' | 'rent'
  furnished          Boolean?
  // Amenities structured from source (union of all sources)
  amenities          Json?          @db.JsonB
  // Amenities extracted by LLM from description at ingestion time
  extractedAmenities Json?          @map("extracted_amenities") @db.JsonB
  firstSeenAt        DateTime       @default(now()) @map("first_seen_at") @db.Timestamptz
  lastSeenAt         DateTime       @default(now()) @map("last_seen_at") @db.Timestamptz
  active             Boolean        @default(true)

  sources            PropertySource_[]  @relation("PropertySources")
  briefingResults    BriefingResult[]

  @@index([geohash7])
  @@index([city, neighborhood])
  @@index([price])
  @@index([bedrooms])
  @@index([active, lastSeenAt(sort: Desc)])
  @@map("properties")
}

// DATA-2: Raw listing data from each source for a canonical property.
// Keeps the original URL, photos, and full description per source.
model PropertySource_ {
  id                  String         @id @default(uuid()) @db.Uuid
  propertyId          String         @map("property_id") @db.Uuid
  source              PropertySource
  externalId          String?        @map("external_id")
  url                 String
  title               String?
  description         String?
  photos              Json?          @db.JsonB  // String[] of photo URLs
  rawPrice            Decimal        @map("raw_price") @db.Decimal(14, 2)
  rawData             Json?          @map("raw_data") @db.JsonB // full raw payload
  scrapedAt           DateTime       @default(now()) @map("scraped_at") @db.Timestamptz

  property            Property       @relation("PropertySources", fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([source, externalId])
  @@index([propertyId])
  @@index([source, scrapedAt(sort: Desc)])
  @@map("property_sources")
}

// ---------------------------------------------------------------------------
// Sprint 4 tables — DATA-3
// ---------------------------------------------------------------------------

// DATA-3: Links a briefing to its ranked, deduplicated property results.
// One row per (briefing, property) pair. Supports WhatsApp selection (Sprint 6).
model BriefingResult {
  briefingId      String   @map("briefing_id") @db.Uuid
  propertyId      String   @map("property_id") @db.Uuid
  fitScore        Int      @map("fit_score")
  scoreBreakdown  Json?    @map("score_breakdown") @db.JsonB
  rank            Int
  selected        Boolean  @default(false)
  personalNote    String?  @map("personal_note")
  autoWidenUsed   Boolean  @default(false) @map("auto_widen_used")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  briefing        Briefing @relation(fields: [briefingId], references: [id], onDelete: Cascade)
  property        Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([briefingId, propertyId])
  @@index([briefingId, rank])
  @@map("briefing_results")
}

// ---------------------------------------------------------------------------
// Sprint 6 tables — DATA-6
// ---------------------------------------------------------------------------

enum MessageDeliveryMethod {
  clipboard
  whatsapp_api
}

enum MessageDeliveryStatus {
  pending
  copied
  sent
  delivered
  read
  failed
}

// DATA-6: WhatsApp messages generated from briefing results.
// OPS-7: phone_hash populated 90d post-send; raw phone purged.
model Message {
  id             String                @id @default(uuid()) @db.Uuid
  briefingId     String                @map("briefing_id") @db.Uuid
  clientId       String                @map("client_id") @db.Uuid
  formattedText  String                @map("formatted_text")
  deliveryMethod MessageDeliveryMethod @default(clipboard) @map("delivery_method")
  deliveryStatus MessageDeliveryStatus @default(pending) @map("delivery_status")
  sentAt         DateTime?             @map("sent_at") @db.Timestamptz
  phoneHash      String?               @map("phone_hash") @db.VarChar(64)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz

  briefing       Briefing              @relation(fields: [briefingId], references: [id], onDelete: Cascade)
  client         Client                @relation(fields: [clientId], references: [id])
  shortLinks     ShortLink[]

  @@index([briefingId])
  @@index([clientId])
  @@map("messages")
}

// DATA-6: Short link for property URLs in WhatsApp messages.
model ShortLink {
  id         String    @id @default(uuid()) @db.Uuid
  slug       String    @unique @db.VarChar(10)
  targetUrl  String    @map("target_url")
  messageId  String?   @map("message_id") @db.Uuid
  clicks     Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  message    Message?  @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([messageId])
  @@map("short_links")
}

// AUTH-1: Compliance and security audit trail (24-month legal retention)
// actor_user_id is tokenized after 12 months by the OPS-6 cron job.
model AuditLog {
  id           String    @id @default(uuid()) @db.Uuid
  action       String
  targetType   String?   @map("target_type")
  targetId     String?   @map("target_id") @db.Uuid
  details      Json?     @db.JsonB
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  actorUser    User?     @relation(fields: [actorUserId], references: [id])
  actorUserId  String?   @map("actor_user_id") @db.Uuid

  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@map("audit_log")
}
