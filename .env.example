# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit secrets.
# See docs/dev-setup.md and ADR-0009 for the secrets strategy.

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://propmatch:dev@localhost:5432/propmatch_dev"

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL="redis://:dev@localhost:6379"

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET="change-me-in-production"
JWT_REFRESH_SECRET="change-me-in-production"
ARGON2_PEPPER="change-me-in-production"

# ─── LLM via OpenRouter ───────────────────────────────────────────────────────
# Crie uma conta em https://openrouter.ai → API Keys → gere uma chave
# O modelo padrão é anthropic/claude-haiku-4-5 (barato). Pode trocar por
# google/gemini-flash-1.5, meta-llama/llama-3-8b-instruct, etc.
OPENROUTER_API_KEY="sk-or-v1-your-key-here"

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# "noop" disables email sending for local dev
RESEND_API_KEY="noop"

# ─── Billing (Stripe) ─────────────────────────────────────────────────────────
# Only needed when working on billing flows
STRIPE_SECRET_KEY="sk_test_your-stripe-key-here"
STRIPE_WEBHOOK_SECRET="whsec_your-webhook-secret-here"

# ─── Observability ────────────────────────────────────────────────────────────
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# ─── Search / Sources ─────────────────────────────────────────────────────────
# Firecrawl — primary web scraper (https://firecrawl.dev)
FIRECRAWL_API_KEY=""

# Set to "true" to use mock adapter (no real scraping — for local dev)
SOURCE_MOCK="true"

# Cron secret — protects POST /api/v1/internal/cron/retention
CRON_SECRET="change-me-in-production"

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NODE_ENV="development"
